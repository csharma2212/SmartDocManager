# ==============================================================================
# SmartDocManager — Git Ignore Specification
# ==============================================================================

# --- Python & Desktop Build Artifacts ---
.venv/
windows/.venv/
env/
venv/
ENV/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/
*.spec
*.exe
*.lnk

# --- Local Databases & Metadata ---
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
.smartdocmanager/

# --- Android, Gradle & Native Toolchains ---
.gradle/
android/.gradle/
android/build/
android/app/build/
**/build/
android/.kotlin/
android/captures/
android/.cxx/
local.properties
android/local.properties
*.iml
.idea/

# --- Secrets, Keystores & Fingerprints (Security Critical) ---
keystores/
*.jks
*.keystore
keystore.properties
signing.properties
signing-fingerprints.txt
*fingerprint*.txt
*sha1*.txt
android-credentials.json
.env
*.local.json
*.key
*.pem

# --- Node.js & Cloudflare ---
node_modules/
hosted-backend/cloudflare/node_modules/
.wrangler/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Build Outputs, Execution Logs & Scaffolding ---
output/
logs/
backups/
diagnostics/*.log
diagnostics/build-session.log
*.log

# --- Distribution & Archive Artifacts ---
*.zip
*.tar.gz
*.7z
*.b64
*.rar

# --- IDE, Editor & OS Caches ---
.vscode/
.agents/
.gemini/
.claude/
.cursor/
*.code-workspace
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.tmp
*.temp
*.bak
*.swp
